DATABASE_URL=postgresql://edgeos:edgeos@localhost:5433/edgeos
REDIS_URL=redis://localhost:6379/0
DATA_SOURCE=dev_local          # dev_local | licensed_vendor (services/pipelines/sources.py)
LICENSED_VENDOR=               # e.g. accord, cmots, nse_dna once a feed is contracted
NIGHTLY_BUDGET_USD=150         # report batch: stop starting new subjects once LLM spend reaches this
NIGHTLY_WORKERS=16
SERVE_DEV_DATA=                # 1 = API shows dev_local data, marked dev_only (refused unless DATA_SOURCE=dev_local)
FIREBASE_PROJECT_ID=           # ask box sign-in; unset -> /api/ask answers 503
ASK_DAILY_LIMIT=20             # ask-box questions per user per IST day
